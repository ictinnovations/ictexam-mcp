# ICTExam MCP server configuration.
# Copy to .env or set these in your MCP client config.

# Required: your ICTExam site and a teacher/admin account.
ICTEXAM_BASE_URL=https://app.ictlms.net
ICTEXAM_EMAIL=teacher@example.com
ICTEXAM_PASSWORD=change-me

# Optional: API mount path. Default /api. Set empty to hit the backend port directly.
# ICTEXAM_API_PREFIX=/api

# Optional: unlock write tools (parse-with-AI, publish, unpublish). Off by default.
# ICTEXAM_MCP_ALLOW_WRITE=true

# Optional tuning.
# ICTEXAM_TIMEOUT_MS=60000
# ICTEXAM_TLS_INSECURE=false
